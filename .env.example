# Local model directories; replace with absolute paths for your machine.
TALDAU_ASR_ENGINE=mixed-ctc
TALDAU_ASR_MODEL=models/mixed-stt
# 1 = greedy (default); 8 = experimental prefix beam search.
TALDAU_CTC_BEAM_SIZE=1
TALDAU_DIARIZATION_MODEL=models/speaker-diarization-community-1
TALDAU_LLM_MODEL=taldau-kazllm
# Optional KazLLM correction suggestions for mixed Kazakh-Russian ASR.
# Requires gated model access and local installation in Ollama.
# TALDAU_KAZLLM_MODEL=taldau-kazllm
TALDAU_OLLAMA_URL=http://127.0.0.1:11434
TALDAU_DEVICE=cpu
