DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/taldau
ASR_BACKEND=local_ml
LLM_BACKEND=local_ml
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
TALDAU_TIMEZONE=Asia/Almaty

# Optional fixture for checking the ML adapter without model weights.
# When set, it takes precedence over ASR_BACKEND and LLM_BACKEND.
# TALDAU_ML_RESULT_FIXTURE=examples/results/meeting_result.json

TALDAU_ASR_ENGINE=mixed-ctc
# Relative model paths are resolved from the repository root by backend.
TALDAU_ASR_MODEL=models/mixed-stt
TALDAU_DIARIZATION_MODEL=models/speaker-diarization-community-1
TALDAU_LLM_MODEL=qwen2.5:7b
# Optional; enable only when this model is installed in Ollama.
# TALDAU_KAZLLM_MODEL=taldau-kazllm
TALDAU_OLLAMA_URL=http://127.0.0.1:11434
TALDAU_DEVICE=cpu

# Automatic reminders in the shared local inbox (not external email).
TALDAU_REMINDERS_ENABLED=true
TALDAU_REMINDERS_INTERVAL_SECONDS=60
