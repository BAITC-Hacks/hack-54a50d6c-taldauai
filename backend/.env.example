DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/taldau
TALDAU_TIMEZONE=Asia/Almaty

# Use the committed result to verify backend/frontend integration without model weights.
# Remove this line to run the real local process_meeting pipeline.
TALDAU_ML_RESULT_FIXTURE=examples/results/meeting_result.json

TALDAU_ASR_ENGINE=mixed-ctc
TALDAU_ASR_MODEL=/absolute/path/to/models/mixed-stt
TALDAU_DIARIZATION_MODEL=/absolute/path/to/models/speaker-diarization-community-1
TALDAU_LLM_MODEL=taldau-kazllm
TALDAU_KAZLLM_MODEL=taldau-kazllm
TALDAU_OLLAMA_URL=http://127.0.0.1:11434
TALDAU_DEVICE=cpu
